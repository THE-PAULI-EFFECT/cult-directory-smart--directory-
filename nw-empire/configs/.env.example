# NW Directory Empire — Environment Variables
# Copy to .env and fill in values

# ── PocketBase ────────────────────────────────────────────────────────────────
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@nw-empire.local
POCKETBASE_ADMIN_PASSWORD=ChangeMe2025!

# ── Next.js Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090
NEXT_PUBLIC_SITE_NAME="WA Porta Potty Directory"
NEXT_PUBLIC_SITE_DOMAIN="wa-portapotty.com"
NEXT_PUBLIC_NICHE=porta_potty

# ── Email (Resend) ────────────────────────────────────────────────────────────
